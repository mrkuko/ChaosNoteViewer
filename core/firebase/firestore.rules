rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Every user touches only their own subtree.
    match /users/{uid} {

      match /notes/{noteId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.serverUpdatedAt == request.time  // pull cursor must be server time
          && request.resource.data.content is string
          && request.resource.data.content.size() < 200000;
        // A client deletes a note for real once the user removed it. There are no tombstones: devices that
        // still have it find out by comparing with the server and offer to upload it again.
        allow delete: if isOwner(uid);
      }

      // encryption key check (an encrypted known string, never the key itself)
      match /meta/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Signed in as this user AND the email is confirmed. email_verified is a claim inside the id token
    // that Google signs, so a modified client or a hand-made API call can't fake it. Without this check
    // anyone could sign up with an address that isn't theirs and use the database.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
  }
}
